# Copie para `.env` na pasta mobile/ (não versionar). Dispositivo físico: use o IP da máquina na LAN, não localhost.
# API: base com sufixo /api (igual VITE_API_BASE_URL no frontend web)

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.119:3333/api
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
