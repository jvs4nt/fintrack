# Copie para `.env` na pasta mobile/ (não versionar).
# Produção (EAS APK): URL HTTPS da API.
# Expo Go: por padrão http://<IP do Metro>:3333/api. Se falhar, force o IP do Mac:
# EXPO_PUBLIC_DEV_API_BASE_URL=http://192.168.1.x:3333/api

EXPO_PUBLIC_API_BASE_URL=https://fintrack-ppl4.onrender.com/api
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
