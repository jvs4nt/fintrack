# Copie para frontend/.env (não versionar).
#
# Dev (npm run dev): useApi usa /api relativo; o Vite faz proxy para localhost:3333.
# Não precisa de IP da LAN no notebook — só reinicie o Vite após mudar este arquivo.
#
# Produção (npm run build): URL absoluta do backend com sufixo /api.
# Ex.: VITE_API_BASE_URL=https://api.seudominio.com/api

VITE_API_BASE_URL=http://localhost:3333/api
VITE_SUPABASE_URL=https://[ref].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
