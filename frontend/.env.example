# Produção / build: URL completa da API.
# Dev: o app chama sempre /api (proxy Vite). O host do proxy vem da origin desta URL
# (ex. Render) ou http://localhost:3333 se omitir ou usar localhost abaixo.
VITE_API_BASE_URL="http://localhost:3333/api"
# Produção (Railway):
# VITE_API_BASE_URL="https://fintrack-api-production-7b95.up.railway.app/api"

VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"

# Produção (Railway): URL pública do app para links de e-mail no build.
# VITE_APP_URL="https://fintrack-production-dd54.up.railway.app"
# Dev local: omita — o redirect usa window.location.origin (http://localhost:5173).
