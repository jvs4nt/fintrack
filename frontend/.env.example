# Copie para frontend/.env (não versionar).
#
# Dev (npm run dev):
# - Backend local: comente ou remova VITE_API_BASE_URL → useApi usa /api (proxy Vite).
# - API remota (Render): URL absoluta abaixo; reinicie o Vite após mudar.
#
# Produção (npm run build): URL absoluta da API com sufixo /api.

VITE_API_BASE_URL=https://fintrack-ppl4.onrender.com/api
VITE_SUPABASE_URL=https://[ref].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
