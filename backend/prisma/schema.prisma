// FinTrack - Schema Prisma (PostgreSQL / Supabase)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model FixedIncome {
  id          Int      @id @default(autoincrement())
  userId      String
  name        String
  amount      Float
  dayOfMonth  Int
  category    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model FixedExpense {
  id             Int      @id @default(autoincrement())
  userId         String
  name           String
  amount         Float
  dayOfMonth     Int
  category       String
  paymentMethod  String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([userId])
}

model MonthEntry {
  id            Int      @id @default(autoincrement())
  userId        String
  year          Int
  month         Int
  type          String
  description   String
  amount        Float
  date          String
  category      String
  paymentMethod String?
  note          String?
  isFixed       Boolean  @default(false)
  fixedRefId    Int?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([userId, year, month])
}

model FixedMonthSkip {
  id          Int    @id @default(autoincrement())
  userId      String
  year        Int
  month       Int
  type        String
  fixedRefId  Int

  @@unique([userId, year, month, type, fixedRefId])
}

model Card {
  id             Int            @id @default(autoincrement())
  userId         String
  name           String
  lastFourDigits String?
  color          String
  closingDay     Int
  dueDay         Int
  limit          Float
  createdAt      DateTime       @default(now())
  installments   Installment[]

  @@index([userId])
}

model Installment {
  id                 Int      @id @default(autoincrement())
  description        String
  totalAmount        Float
  totalInstallments  Int
  currentInstallment Int      @default(1)
  firstPaymentDate   String
  cardId             Int
  card               Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  status             String   @default("active")
  createdAt          DateTime @default(now())
}

model Saving {
  id          Int             @id @default(autoincrement())
  userId      String
  name        String
  institution String
  type        String
  amount      Float
  updatedAt   DateTime        @updatedAt
  createdAt   DateTime        @default(now())
  history     SavingHistory[]

  @@index([userId])
}

model SavingHistory {
  id       Int      @id @default(autoincrement())
  savingId Int
  saving   Saving   @relation(fields: [savingId], references: [id], onDelete: Cascade)
  amount   Float
  date     DateTime @default(now())
}

model Category {
  id     Int    @id @default(autoincrement())
  userId String
  name   String
  type   String

  @@unique([userId, name, type])
  @@index([userId])
}

model MonthlyBudget {
  id          Int   @id @default(autoincrement())
  userId      String
  year        Int
  month       Int
  category    String
  limitAmount Float

  @@unique([userId, year, month, category])
  @@index([userId])
}

model Settings {
  userId    String   @id
  payday    Int      @default(1)
  updatedAt DateTime @updatedAt
}
