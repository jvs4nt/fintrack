PORT=3333
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Postgres (Supabase) — use pooler na app, direta nas migrations
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[ref].supabase.co:5432/postgres"

# Supabase Auth (backend valida JWT)
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Opcional: service role para scripts admin (nunca no frontend)
# SUPABASE_SERVICE_ROLE_KEY="..."

# Seed: UUID do usuário após primeiro login (Dashboard Supabase → Auth → Users)
# SEED_USER_ID="00000000-0000-0000-0000-000000000000"
